{
  "name": "clew",
  "version": "0.0.1",
  "private": true,
  "description": "Chat with Claude Code or Codex beside your notes. Highlight and scroll to parts of the note, quote text into the chat, and get native visuals, using your own subscription or BYOK.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:live": "tsx --test tests/live/agents.test.ts",
    "bench": "tsx bench/bench.ts",
    "eval": "tsx bench/eval.ts",
    "coverage:visuals": "node --import tsx bench/visuals/run.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@lezer/markdown": "1.7.2",
    "@openuidev/lang-core": "1.0.1",
    "cross-spawn": "7.0.6",
    "tslib": "^2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/cross-spawn": "6.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.5.2",
    "obsidian": "1.14.4",
    "pele": "1.9.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
